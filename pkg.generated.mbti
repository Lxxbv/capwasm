pub(all) struct WasiEnvironment {
  args : Array[String]
  env_vars : Array[(String, String)]
  mounts : Array[ExtismPathMount]
  mut virtual_clock_ns : Int64
  mut prng_state : UInt64
  mut last_exit_code : Int32?
}
pub fn WasiEnvironment::add_arg(Self, String) -> Unit
pub fn WasiEnvironment::add_mount(Self, ExtismPathMount) -> Unit
pub fn WasiEnvironment::new() -> Self
pub fn WasiEnvironment::next_random_byte(Self) -> Byte
pub fn WasiEnvironment::set_env(Self, String, String) -> Unit

pub(all) struct WasiFd {
  fd : Int32
  path : String
  file : InMemoryFile
  flags : OpenFlags
}

pub(all) struct WasiFdTable {
  fds : Array[WasiFd]
  mut next_fd : Int32
}
pub fn WasiFdTable::close_fd(Self, Int32) -> Result[Unit, Int32]
pub fn WasiFdTable::get_fd(Self, Int32) -> WasiFd?
