pub fn WasiFdTable::get_stdout_string(Self) -> String
pub fn WasiFdTable::new() -> Self
pub fn WasiFdTable::open_file(Self, InMemoryFile, OpenFlags) -> Int32
pub fn WasiFdTable::read(Self, Int32, Int32) -> Result[Array[Byte], Int32]
pub fn WasiFdTable::seek(Self, Int32, Int32, Int32) -> Result[Int32, Int32]
pub fn WasiFdTable::write(Self, Int32, Array[Byte]) -> Result[Int32, Int32]

pub(all) struct WasmInstance {
  functions : Array[FunctionInstance]
  memories : Array[LinearMemory]
  globals : Array[GlobalInstance]
  mut tables : Array[TableInstance]
  mut types : Array[FuncType]
  stack : OperandStack
  call_stack : Array[CallFrame]
  control_stack : Array[ControlFrame]
  host_context : HostContext
  mut gas_limit : Int32
  mut gas_consumed : Int32
}
pub fn WasmInstance::call_exported(Self, WasmModule, String, Array[Value]) -> Result[Array[Value], Trap]
pub fn WasmInstance::consume_gas(Self, Int32) -> Result[Unit, Trap]
pub fn WasmInstance::get_consumed_gas(Self) -> Int32
pub fn WasmInstance::get_memory(Self, Int32) -> Result[LinearMemory, Trap]
pub fn WasmInstance::invoke(Self, Int32, Array[Value]) -> Result[Array[Value], Trap]
pub fn WasmInstance::new(Array[FunctionInstance], Array[LinearMemory], Array[GlobalInstance], HostContext, Int32) -> Self

pub(all) struct WasmModule {
  types : Array[FuncType]
  imports : Array[ImportEntry]
  func_types : Array[Int32]
  tables : Array[TableType]
  memories : Array[MemoryType]
  globals : Array[GlobalEntry]
  exports : Array[ExportEntry]
  start_func : Int32?
  elements : Array[ElementSegment]
  code : Array[FunctionBody]
  data : Array[DataSegment]
} derive(Eq)
pub fn WasmModule::empty() -> Self
pub fn WasmModule::encode_to_bytes(Self) -> Array[Byte]
pub fn WasmModule::find_func_export(Self, String) -> Int32?
