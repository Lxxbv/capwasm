pub fn WasmModule::get_func_type(Self, Int32) -> Result[FuncType, Trap]
pub fn WasmModule::get_imported_func_count(Self) -> Int32
pub fn WasmModule::instantiate(Self, Linker, HostContext, Int32) -> Result[WasmInstance, Trap]
pub impl Show for WasmModule

